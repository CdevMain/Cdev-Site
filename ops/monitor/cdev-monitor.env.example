# Copie para /etc/cdev-monitor.env (chmod 600, dono root). NUNCA commite o arquivo real.
# Supabase > Project Settings > API
SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Secret key (sb_secret_...) ou service_role legada (eyJ...). Somente no servidor.
SUPABASE_SERVICE_KEY=

# Opcionais
CONCURRENCY=8
DUE_CHECK_EVERY_MIN=10
STATE_DIR=/var/lib/cdev-monitor

# Canal externo GRATUITO opcional: alertas no Telegram (crie um bot com @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
