# Quebras de linha: o repositorio guarda LF; scripts e configs do servidor sempre em LF
# (evita que .sh / .conf / .service cheguem na VPS com CRLF e parem de funcionar)
* text=auto eol=lf
*.sh text eol=lf
*.mjs text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.example text eol=lf
*.sql text eol=lf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary
